<% layout('/layouts/boilerplate') %>

<div id="filters" class="sticky-top">
  <div class="filter active">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-city"></i></div>
    <p>Cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-sun"></i></div>
    <p>Amazing views</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-umbrella-beach"></i></div>
    <p>Beachfront</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tree"></i></div>
    <p>Cabins</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-cow" style="color: #437fcc;"></i></div>
    <p>farms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-campground" style="color: #437fcc;"></i></div>
    <p>Forest</p>
  </div>

  <div class="right-controls">
    <form class="airbnb-search" id="listingSearchForm" role="search">
      <input
        type="search"
        id="listingSearchInput"
        placeholder="Search destinations"
        aria-label="Search destinations"
      />
      <button type="submit" class="airbnb-search-btn" aria-label="Search">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </form>

    <div class="tax-toggle">
      <div class="form-check form-switch m-0">
        <input class="form-check-input" type="checkbox" role="switch" id="switchSizeSm">
        <label class="form-check-label" for="switchSizeSm">Display total before taxes</label>
      </div>
    </div>
  </div>
</div>

<!-- max-width constraint mimics a zoomed-out view on large monitors -->
<div class="container-fluid px-4 px-lg-5 my-4 mx-auto" style="max-width: 1350px;" >
    <!-- Header Section -->

    <!-- Listings Grid -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4" id="listingsGrid">
        <% for (let listing of allListings) { %>
            <div class="col listing-col" data-title="<%= (listing.title || '').toLowerCase() %>" data-location="<%= (listing.location || '').toLowerCase() %>">
                <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none">
                    <div class="card listing-card border-0 shadow-sm h-100 bg-transparent">
                        <img 
                            src="<%= listing.image.url %>" 
                            class="card-img-top rounded-4" 
                            alt="listing image" 
                            style="height: 16rem; object-fit: cover;"
                        >
                        <div class="card-body px-0 pt-2">
                            <p class="card-text text-dark" style="font-size: 0.88rem;">
                                <strong><%= listing.title %></strong> <br>
                                <span class="text-muted">&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> / night</span>
                                <i class="gst-info">+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
</div>
<script src="/js/tax.js"></script>